{
	"name": "vozcatolicablog/weekly-content-concatenator",
	"description": "WordPress plugin for weekly content entries inside regular posts.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs --standard=WordPress --extensions=php . --ignore=vendor/",
		"lint:fix": "phpcbf --standard=WordPress --extensions=php . --ignore=vendor/"
	}
}
